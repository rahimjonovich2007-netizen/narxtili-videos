[
 {
  "n": "01",
  "spk": "hik",
  "text": "Har tun, soat uchdan yetti daqiqa o'tganda, minora soati to'xtaydi.",
  "file": "in/line_01_hik.wav"
 },
 {
  "n": "02",
  "spk": "hik",
  "text": "Va butun mahalla qorong'iga cho'madi.",
  "file": "in/line_02_hik.wav"
 },
 {
  "n": "03",
  "spk": "jasur",
  "text": "Malika, men qo'rqayotganim yo'q. Faqat... sovuq qotdim.",
  "file": "in/line_03_jasur.wav"
 },
 {
  "n": "04",
  "spk": "malika",
  "text": "Ha-ha, sovuqdan tishlaring taqillayaptimi?",
  "file": "in/line_04_malika.wav"
 },
 {
  "n": "05",
  "spk": "malika",
  "text": "Jim! Soat hali yuryapti. Bir daqiqa qoldi, yur!",
  "file": "in/line_05_malika.wav"
 },
 {
  "n": "06",
  "spk": "jasur",
  "text": "Eshik qulflangan-ku! Endi nima qilamiz?",
  "file": "in/line_06_jasur.wav"
 },
 {
  "n": "07",
  "spk": "jasur",
  "text": "Voy! Tuman?! Bu kalitni qayerdan topding?",
  "file": "in/line_07_jasur.wav"
 },
 {
  "n": "08",
  "spk": "malika",
  "text": "Qara, kalitda yetti raqami yozilgan!",
  "file": "in/line_08_malika.wav"
 },
 {
  "n": "09",
  "spk": "malika",
  "text": "Tezroq, ichkariga!",
  "file": "in/line_09_malika.wav"
 },
 {
  "n": "10",
  "spk": "malika",
  "text": "Oltita kalit osilib turibdi... yettinchi ilgak bo'sh.",
  "file": "in/line_10_malika.wav"
 },
 {
  "n": "11",
  "spk": "jasur",
  "text": "Soat! Hozir uchdan yetti daqiqa bo'ladi!",
  "file": "in/line_11_jasur.wav"
 },
 {
  "n": "12",
  "spk": "malika",
  "text": "Kalitni osaman, orqaga tur!",
  "file": "in/line_12_malika.wav"
 },
 {
  "n": "13",
  "spk": "notanish",
  "text": "Yettinchi kalit... nihoyat keldi. Sizlarni kutgan edim.",
  "file": "in/line_13_notanish.wav"
 },
 {
  "n": "14",
  "spk": "hik",
  "text": "Sizningcha, bu kim? Izohda yozing.",
  "file": "in/line_14_hik.wav"
 }
]